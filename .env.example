# =====================================================================
# Copia este archivo como ".env" y llena los valores reales de TU
# ambiente. El ".env" real NUNCA debe subirse a control de versiones
# (ya está en .gitignore) ni compartirse por chat/correo en texto plano.
# Colócalo directamente en el ambiente restringido donde corra la API.
# =====================================================================

# --- Conexión a SQL Server ---
# DB_AUTH_MODE = "windows" (integrada, sin usuario/contraseña aquí)
#              o "sql" (usuario/contraseña de SQL Server)
DB_AUTH_MODE=sql
DB_SERVER=NOMBRE_SERVIDOR\INSTANCIA
DB_NAME=NombreBaseDatosDesarrollo
DB_DRIVER=ODBC Driver 17 for SQL Server

# Solo si DB_AUTH_MODE=sql. Llena TÚ estos dos valores directamente en
# tu .env local (nunca los compartas por chat ni los subas a un repo):
DB_USER=
DB_PASSWORD=

# Solo aplica con ODBC Driver 18. true (default) confía en el certificado
# del SQL Server sin validarlo -- cómodo en desarrollo, pero en producción
# ponlo en false (y asegúrate de que el SQL Server tenga un certificado
# válido) para que la conexión no quede expuesta a un MITM en el enlace
# de red que uses.
DB_TRUST_SERVER_CERTIFICATE=true

# --- Base local SQLite (estatus de expedientes / config. cuentas) ---
LOCAL_DB_PATH=./data/app_local.db

# --- Catálogo de cuentas con restricción fija (ver sql/README.md) ---
# Dejar vacío para NO restringir. (El catálogo de subservicios ya NO usa
# esto: ahora es dinámico en cascada del combo Servicio.)
CUENTAS_PERMITIDAS=90,1771,2228,2453,2455,2504,2539,2541,2559,2560,2623,2624,2665,2785,2786,2819,2868,2907,2958,2963,2997,2998,2999,3006

# --- Correo a proveedores (botón "Enviar correo a proveedores" y el cron
# jobs/validar_estatus_proveedor.py). Mientras SMTP_HOST y SMTP_REMITENTE
# estén vacíos, el envío queda "simulado" (solo se registra en el log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_REMITENTE=
SMTP_USAR_TLS=true

# --- Sesión (JWT propio de esta app, no relacionado al SP de login) ---
# Genera un valor único por ambiente con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CAMBIA-ESTE-VALOR-EN-TU-.env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- CORS ---
# El portal (frontend/) lo sirve la misma app, así que no necesita CORS; esto
# solo aplica a clientes externos que consuman la API desde otro origen.
# "*" (default) permite cualquier origen. ANTES de pasar a producción, pon aquí la URL exacta del frontend definitivo (separadas por
# coma si son varias), ej: https://expedientes.ike.local
CORS_ALLOWED_ORIGINS=*

# --- GraphQL (/graphql) ---
# GraphiQL (explorador visual) e introspección: cómodos en desarrollo, pero
# exponen el schema completo sin autenticación. Pon esto en false en producción.
GRAPHQL_IDE_HABILITADO=true
