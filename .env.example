# =====================================================================
# Copia este archivo como ".env" y llena los valores reales de TU
# ambiente. El ".env" real NUNCA debe subirse a control de versiones
# (ya está en .gitignore) ni compartirse por chat/correo en texto plano.
# Colócalo directamente en el ambiente restringido donde corra la API.
# =====================================================================

# --- Conexión a SQL Server ---
# DB_AUTH_MODE = "windows" (integrada, sin usuario/contraseña aquí)
#              o "sql" (usuario/contraseña de SQL Server)
DB_AUTH_MODE=sql
DB_SERVER=NOMBRE_SERVIDOR\INSTANCIA
DB_NAME=NombreBaseDatosDesarrollo
DB_DRIVER=ODBC Driver 17 for SQL Server

# Solo si DB_AUTH_MODE=sql. Llena TÚ estos dos valores directamente en
# tu .env local (nunca los compartas por chat ni los subas a un repo):
DB_USER=
DB_PASSWORD=

# Solo aplica con ODBC Driver 18. true (default) confía en el certificado
# del SQL Server sin validarlo -- cómodo en desarrollo, pero en producción
# ponlo en false (y asegúrate de que el SQL Server tenga un certificado
# válido) para que la conexión no quede expuesta a un MITM en el enlace
# de red que uses.
DB_TRUST_SERVER_CERTIFICATE=true

# --- Base local SQLite (estatus de expedientes / config. cuentas) ---
LOCAL_DB_PATH=./data/app_local.db

# --- Catálogo de cuentas con restricción fija (ver sql/README.md) ---
# Dejar vacío para NO restringir. (El catálogo de subservicios ya NO usa
# esto: ahora es dinámico en cascada del combo Servicio.)
CUENTAS_PERMITIDAS=90,1771,2228,2453,2455,2504,2539,2541,2559,2560,2623,2624,2665,2785,2786,2819,2868,2907,2958,2963,2997,2998,2999,3006

# --- Correo a proveedores (botón "Enviar correo a proveedores" y el cron
# jobs/validar_estatus_proveedor.py). Mientras SMTP_HOST y SMTP_REMITENTE
# estén vacíos, el envío queda "simulado" (solo se registra en el log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_REMITENTE=
SMTP_USAR_TLS=true
# Para probar en desarrollo: si tiene valor, TODO correo (a proveedores y el
# corte) se manda aquí en vez de a los destinatarios reales, para no
# escribirle a nadie más. En producción va VACÍO.
SMTP_DESTINATARIO_PRUEBA=
SMTP_TIMEOUT_SEGUNDOS=15

# --- Tope diario de correos (la cuenta de correo permite 100 al día) ---
# Es uno solo para todo el portal: "Enviar correo a proveedores" y el corte
# lo comparten. Se reinicia a medianoche, hora del centro de México.
SMTP_LIMITE_DIARIO=100
# A partir de cuántos correos usados se pide confirmación antes de enviar.
SMTP_AVISO_LIMITE=80
# true = cada destinatario cuenta 1 (un correo a 8 proveedores gasta 8);
# false = cada mensaje cuenta 1. Dejar en true mientras no se confirme cómo
# cuenta el servidor de correo.
SMTP_CUENTA_POR_DESTINATARIO=true
# Horas que deben pasar para volver a mandarle correo a proveedores sobre el
# mismo expediente.
CORREO_REENVIO_HORAS=8

# --- Secretos en AWS Secrets Manager (ver app/core/secretos_aws.py) ---
# En AWS las llaves NO se dejan en este archivo: las administra Secrets
# Manager. Al arrancar, la app las lee y las deja en el entorno, y GANAN sobre
# lo que diga este .env (así una llave vieja olvidada aquí no tiene prioridad).
#
# "off"         -> no toca AWS (default: desarrollo y pruebas, sin boto3).
# "obligatorio" -> si el secreto no se puede leer, la app NO arranca. Es lo
#                  que debe usarse en producción.
# "opcional"    -> si falla, sigue con el entorno. Solo para la primera puesta
#                  en marcha, mientras se ajustan los permisos de IAM.
SECRETOS_AWS_MODO=off
SECRETOS_AWS_NOMBRE=encryption-portal-medicos
SECRETOS_AWS_REGION=mx-central-1
# Solo si el secreto se guardó como texto plano (una llave suelta) en vez de
# JSON: dice a qué variable corresponde ese valor. Con el secreto en JSON
# (recomendado) va vacío.
SECRETOS_AWS_CLAVE=

# --- Búsqueda fuera de la red: Google Maps (Places API) ---
# Alimenta "Buscar fuera de la red" del Directorio de Proveedores, que
# muestra establecimientos candidatos a contratar cuando la red no tiene
# cobertura en una zona. Google indexa el giro real del negocio, a cambio
# de costo por consulta y de traer el nombre del médico y reseñas de
# pacientes. Necesita un proyecto de Google Cloud con la "Places API"
# habilitada y CON FACTURACIÓN ACTIVA (Google no deja usar la llave sin eso,
# aunque haya crédito mensual gratuito):
#   https://developers.google.com/maps/documentation/places/web-service/get-api-key
# Llena el valor TÚ en tu .env local (este archivo sí se sube al repo).
# Mientras esté vacío, esa búsqueda queda apagada y el portal avisa que
# falta configurarla.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_TIMEOUT_SEGUNDOS=8
GOOGLE_MAPS_MAXIMO_RESULTADOS=20

# --- Mapa de los resultados de Google (Maps JavaScript API) ---
# Los Términos de Servicio de Google prohíben pintar datos de la Places API en
# un mapa que no sea de Google (Maps Service Specific Terms, sección 14.2).
# Por eso este mapa usa Maps JavaScript API y necesita una SEGUNDA llave,
# DISTINTA de GOOGLE_MAPS_API_KEY:
#
#   - GOOGLE_MAPS_API_KEY           -> solo la usa el servidor (Places API).
#   - GOOGLE_MAPS_BROWSER_API_KEY   -> viaja al navegador. RESTRÍNGELA por
#                                      dominio (HTTP referrers) y déjala solo
#                                      con "Maps JavaScript API" habilitada.
#   https://developers.google.com/maps/api-security-best-practices
#
# Sin esta llave la búsqueda sigue funcionando, pero los resultados se
# muestran en lista (el botón "Mapa" no aparece).
GOOGLE_MAPS_BROWSER_API_KEY=
# Opcional: Map ID del estilo del mapa (Cloud Console > Map Management). Sin
# uno se usa DEMO_MAP_ID, que sirve para desarrollo pero no para producción.
GOOGLE_MAPS_MAP_ID=

# --- Sesión (JWT propio de esta app, no relacionado al SP de login) ---
# Genera un valor único por ambiente con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CAMBIA-ESTE-VALOR-EN-TU-.env
JWT_ALGORITHM=HS256
# Duración máxima de una sesión (minutos), aunque haya actividad.
JWT_EXPIRE_MINUTES=480
# Sin actividad durante estos minutos, la sesión se cierra (avisa 1 minuto antes).
SESION_INACTIVIDAD_MINUTOS=30

# --- CORS ---
# El portal (frontend/) lo sirve la misma app, así que no necesita CORS.
# Vacío (default) = no se permite ningún origen externo: lo correcto para QA
# y producción. Solo si un cliente externo consume la API desde otro dominio,
# pon sus URLs exactas separadas por coma. "*" solo en desarrollo.
CORS_ALLOWED_ORIGINS=

# --- GraphQL (/graphql) ---
# GraphiQL (explorador visual) e introspección: cómodos en desarrollo, pero
# exponen el schema completo sin autenticación. false (default) en QA y
# producción; true solo en tu equipo.
GRAPHQL_IDE_HABILITADO=false

# --- Proxy delante de la app (límite de intentos del login por IP) ---
# Cuántos proxies agregan su IP a X-Forwarded-For antes de llegar a la app:
#   1 = un solo proxy (ALB solo, o nginx que reemplaza el encabezado)
#   2 = CloudFront + ALB
#   0 = sin proxy (desarrollo local)
PROXIES_CONFIABLES=1

# --- Login legado por usuario/contraseña de SISE (/auth/login) ---
# El portal entra solo por RFC. Déjalo en false en todos los ambientes.
LOGIN_LEGADO_HABILITADO=false
