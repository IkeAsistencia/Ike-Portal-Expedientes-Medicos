.env
.env.local
data/*.db
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/
.vscode/
.idea/

# Documentos Word/PDF generados (manuales, análisis, guías de despliegue) --
# se depositan en la raíz del proyecto pero no son parte del código.
*.docx
*.pdf

# Paquetes zip para solicitar escaneos de seguridad (SGI/Checkmarx) -- se
# regeneran con `git archive` cuando hagan falta, no es código fuente.
*.zip
