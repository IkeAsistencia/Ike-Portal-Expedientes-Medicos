# EJEMPLO de workflow de despliegue (no está activo).
# Para activarlo, copiarlo a .github/workflows/deploy.yml cuando ya exista el
# servidor y los secretos en GitHub (Settings → Secrets and variables →
# Actions):
#   PROD_HOST, PROD_USER, PROD_SSH_KEY
#
# Etiqueta "v*" (ej. v1.0.0) → despliega en producción. Solo por etiqueta:
# así queda registrado qué versión está corriendo y se puede volver a la
# anterior con el mismo script.
name: Desplegar portal

on:
  push:
    tags: ["v*"]

jobs:
  produccion:
    if: startsWith(github.ref, 'refs/tags/v')
    runs-on: ubuntu-latest
    environment: produccion   # en GitHub se puede exigir aprobación manual
    steps:
      - name: Desplegar en producción por SSH
        uses: appleboy/ssh-action@v1
        with:
          host: ${{ secrets.PROD_HOST }}
          username: ${{ secrets.PROD_USER }}
          key: ${{ secrets.PROD_SSH_KEY }}
          script: /opt/portal-expedientes/deploy/desplegar.sh ${{ github.ref_name }}
